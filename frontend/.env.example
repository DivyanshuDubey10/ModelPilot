# ============================================================
# ModelPilot Frontend — Environment Variables
#
# Vite embeds environment variables starting with VITE_ at build time.
#
# Production (Vercel):
# Set this in Vercel Project Settings → Environment Variables → Production
# Either variable name is supported (VITE_API_BASE_URL takes priority):
# ============================================================

# Primary (recommended for Render deployments):
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# Alternative name (also supported):
# VITE_API_URL=https://your-render-backend.onrender.com

# Local development (optional, Vite proxy automatically forwards /api to http://localhost:8000):
# VITE_API_BASE_URL=http://localhost:8000
